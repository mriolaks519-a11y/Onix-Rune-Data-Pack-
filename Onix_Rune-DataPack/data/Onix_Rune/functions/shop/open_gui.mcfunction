# =====================================================
# Открытие GUI магазина (сундук 9 слотов)
# =====================================================

# Сохраняем игрока в storage для дальнейшего использования
data modify storage onix_rune:tmp player set from entity @s UUID

# Устанавливаем сундук и заполняем его
setblock ~ ~1 ~ chest replace
data modify block ~ ~1 ~ Items set value []

# Заполняем слоты 0-4 текущими предметами из магазина
# Нужно для каждого слота добавить предмет с Lore
# Для упрощения я покажу один пример, остальные аналогично

# Слот 0: предмет с ценой
data modify block ~ ~1 ~ Items append value {
  Slot: 0b,
  id: "minecraft:stone",
  count: 1b,
  tag: {
    display: {
      Name: '{"text":"Камень","color":"white"}',
      Lore: [
        '{"text":"Цена: 10 coins","color":"green"}',
        '{"text":"Нажмите, чтобы продать","color":"gray"}'
      ]
    }
  }
}

# Аналогично для слотов 1-4 (пропустим для краткости)

# Слот 8: кнопка "Обновить"
data modify block ~ ~1 ~ Items append value {
  Slot: 8b,
  id: "minecraft:paper",
  count: 1b,
  tag: {
    display: {
      Name: '{"text":"Обновить","color":"aqua"}',
      Lore: ['{"text":"Нажмите для обновления","color":"gray"}']
    }
  }
}

# Открываем сундук игроку (используем /opengui, но в 1.21.1 нет прямой команды,
# поэтому используем трюк с /item и /data, либо выдаём книгу с кликабельной командой.
# Более простой способ: использовать /trigger для обработки кликов, но это сложнее.
# Временно для теста просто дадим знать, что GUI открыт.
tellraw @s ["",{"text":"[Shop] ","color":"gold"},{"text":"Магазин открыт (пока в разработке).","color":"yellow"}]
